# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3021
APP_ORIGIN=http://localhost:3021
ALLOWED_ORIGINS=http://localhost:3021
DATABASE_PATH=./data/fortless.db
REDIS_URL=redis://127.0.0.1:6379

# Required in production; generate a random value of at least 32 characters.
# Development persists an auto-generated 0600 secret at data/.development-session-secret.
SESSION_SECRET=
FORTLESS_DEV_SECRET_FILE=./data/.development-session-secret

# External services remain disabled until their dedicated sandbox slices pass.
PAYMENTS_MODE=disabled
PROVIDER_MODE=disabled
EMAIL_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PTERODACTYL_PANEL_URL=
PTERODACTYL_API_KEY=
