{
  "name": "fortless",
  "version": "1.0.0",
  "description": "FORTLESS Commercial Hosting & Infrastructure Management Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build:frontend": "esbuild src/frontend/client/index.ts --bundle --format=iife --outfile=public/assets/app-ui.js --target=es2022 && esbuild src/frontend/admin/index.ts --bundle --format=iife --outfile=public/assets/admin-ui.js --target=es2022",
    "build": "npm run build:frontend && tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "staff:bootstrap-owner": "tsx src/scripts/bootstrap-owner.ts",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "keywords": [
    "hosting",
    "pterodactyl",
    "billing",
    "infrastructure",
    "commerce"
  ],
  "author": "FORTLESS Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
