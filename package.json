{
  "name": "fortless",
  "version": "1.0.0",
  "description": "FORTLESS Commercial Hosting & Infrastructure Management Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build:frontend": "esbuild src/frontend/client/index.ts --bundle --format=iife --outfile=public/assets/app-ui.js --target=es2022 && esbuild src/frontend/admin/index.ts --bundle --format=iife --outfile=public/assets/admin-ui.js --target=es2022 && esbuild src/frontend/client/editor/index.ts --bundle --format=iife --minify --outfile=public/assets/editor-ui.js --target=es2022",
    "build": "npm run build:frontend && tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "backup": "tsx src/scripts/backup-restore.ts backup",
    "staff:bootstrap-owner": "tsx src/scripts/bootstrap-owner.ts",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "profiles:import": "tsx src/scripts/import-game-profiles.ts"
  },
  "keywords": [
    "hosting",
    "pterodactyl",
    "billing",
    "infrastructure",
    "commerce"
  ],
  "author": "FORTLESS Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.1.2",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "xlsx": "^0.18.5"
  }
}
